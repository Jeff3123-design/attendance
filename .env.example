# Attendance System Configuration
DEBUG=True
SECRET_KEY=django-insecure-attendance-system-secret-key-change-in-production

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# If DATABASE_URL is not set, SQLite (db.sqlite3) will be used for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/attendance_db

# Alternative individual DB settings if DATABASE_URL is omitted:
# DB_NAME=attendance_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Timezone (East Africa Time)
TIME_ZONE=Africa/Nairobi
